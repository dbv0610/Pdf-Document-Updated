<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/color_f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/lnHeader"
        android:background="@color/doc_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/lnDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="visible">

            <ImageView
                android:id="@+id/icBackApp"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/fileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/rb_400"
                android:includeFontPadding="false"
                android:paddingEnd="@dimen/_6sdp"
                android:singleLine="true"
                android:text="@string/pdf"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp"
                android:visibility="visible"
                tools:ignore="RtlSymmetry" />

            <ImageView
                android:id="@+id/icSearchApp"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_app_search"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/icOpenTools"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_office_menu"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnSearch"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageView
                android:id="@+id/icBackSearch"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_arrow_back" />

            <com.dong.baselib.widget.layout.UiLinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                app:bgColorAll="#66FFFFFF"
                app:cornerRadius="@dimen/_18sdp">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="@font/rb_400"
                    android:hint="@string/search"
                    android:imeOptions="actionSearch"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="@dimen/_12sdp" />

                <ImageView
                    android:id="@+id/icSearch"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:padding="@dimen/_3sdp"
                    android:src="@drawable/ic_app_search"
                    app:tint="@color/white" />
            </com.dong.baselib.widget.layout.UiLinearLayout>
        </LinearLayout>
    </RelativeLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        app:layout_constraintBottom_toTopOf="@+id/lnResultSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lnHeader"
        android:layout_height="0dp">

        <FrameLayout
            android:id="@+id/officeViewer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#4DFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rcvFrameData"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvFrameData"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_6sdp"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.2" />

        <com.dong.baselib.widget.view.UiTextView
            android:id="@+id/txtNumberPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            app:bgColorAll="#80000000"
            app:cornerRadius="@dimen/_18sdp"
            android:includeFontPadding="false"
            android:textSize="@dimen/_10sdp"
            android:layout_margin="@dimen/_12sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_12sdp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <LinearLayout
        android:id="@+id/lnResultSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:visibility="gone"
        android:background="@color/color_f5f5f5"
        android:padding="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvCountSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/rb_500"
            android:includeFontPadding="false"
            android:paddingEnd="@dimen/_6sdp"
            android:singleLine="true"
            android:text="@string/pdf"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
           />
        <ImageView
            android:id="@+id/icViewPrev"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_alt_left"
            android:rotation="90"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/icViewNext"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_alt_left"
            android:rotation="-90"
            app:tint="@color/black" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>