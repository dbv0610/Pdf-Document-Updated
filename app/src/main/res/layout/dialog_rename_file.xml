<?xml version="1.0" encoding="utf-8"?>
<com.dong.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8sdp"
    android:orientation="vertical"
    app:bgColorAll="@color/color_f5f5f5"
    app:cornerRadius="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_12sdp">

        <com.dong.baselib.widget.view.UiTextView
            android:layout_width="0dp"
            android:id="@+id/tvHeader"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/rb_600"
            android:includeFontPadding="false"
            android:text="@string/convert_to_pdf"
            android:textColor="@color/black"
            android:textSize="@dimen/_14sdp" />

        <ImageView
            android:id="@+id/icClose"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_rounded_close"
            app:tint="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <com.dong.baselib.widget.layout.UiLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp"
            app:cornerRadius="@dimen/_8sdp"
            app:stColorAll="@color/color_8c8c8c"
            app:strokeWidth="@dimen/_1sdp">

            <EditText
                android:id="@+id/edtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/transfer"
                android:cursorVisible="true"
                android:focusable="true"
                android:fontFamily="@font/rb_400"
                android:hint="@string/enter_name"
                android:includeFontPadding="false"
                android:inputType="text"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textColorHint="@color/color_8c8c8c"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/_13sdp" />
        </com.dong.baselib.widget.layout.UiLinearLayout>

        <com.dong.baselib.widget.view.UiTextView
            android:id="@+id/btnAgree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="@font/rb_600"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:padding="@dimen/_12sdp"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp"
            app:bgColorAll="@color/color_BA0508"
            app:cornerRadius="@dimen/_8sdp" />
    </LinearLayout>
</com.dong.baselib.widget.layout.UiLinearLayout>
