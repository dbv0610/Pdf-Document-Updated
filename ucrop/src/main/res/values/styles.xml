<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="azcrop_ImageViewWidgetIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:duplicateParentState">true</item>
    </style>


    <style name="azcrop_WrapperTextButtonState">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/azcrop_scale_text_view_selector</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="azcrop_WrapperImageButtonState">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="azcrop_WrapperRotateButton">
        <item name="android:layout_width">@dimen/azcrop_size_wrapper_rotate_button</item>
        <item name="android:layout_height">@dimen/azcrop_size_wrapper_rotate_button</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
    </style>


    <style name="azcrop_TextViewWidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azcrop_color_widget_text</item>
        <item name="android:layout_marginTop">@dimen/azcrop_margin_top_widget_text</item>
        <item name="android:textSize">@dimen/azcrop_text_size_widget_text</item>
    </style>

    <style name="azcrop_TextViewWidget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:layout_marginTop">@dimen/azcrop_margin_top_controls_text</item>
        <item name="android:textColor">@color/azcrop_color_widget_active</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/azcrop_text_size_controls_text</item>
    </style>

    <style name="azcrop_MySeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">#f4511e</item>
        <item name="android:progressTint">#388e3c</item>
        <item name="android:thumbTint">#c51162</item>
    </style>

</resources>